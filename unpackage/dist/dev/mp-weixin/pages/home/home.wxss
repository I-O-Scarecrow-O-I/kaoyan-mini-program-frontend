
.container {
  padding: 20px;
}
.carousel-image {
  width: 100%;
  height: 150px;
  border-radius: 10px;
}
.article-list {
  margin-top: 40px;
}
.article-item {
  display: flex;
  align-items: center;
  margin-bottom: 20px;
}
.article-cover {
  width: 100px;
  height: 100px;
  border-radius: 5px;
  margin-right: 10px;
}
.article-info {
  flex: 1;
}
.article-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 5px;
}
.article-summary {
  color: #666;
}

