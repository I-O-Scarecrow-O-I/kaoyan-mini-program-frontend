<view class="container"><swiper autoplay="{{true}}" indicator-dots="{{true}}"><block wx:for="{{list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><swiper-item data-event-opts="{{[['tap',[['gotoInfoDetail',[index]]]]]}}" bindtap="__e"><image class="carousel-image" src="{{'http://localhost:8081/'+item.value}}" mode="aspectFit"></image></swiper-item></block></swiper><view class="article-list"><block wx:for="{{articles}}" wx:for-item="article" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['goToArticleDetail',['$0'],[[['articles','',index,'url']]]]]]]}}" class="article-item" bindtap="__e"><image class="article-cover" src="{{'http://localhost:8081/'+article.value}}" mode="aspectFill"></image><view class="article-info"><view class="article-title">{{article.title}}</view><view class="article-summary">{{article.summary}}</view></view></view></block></view></view>